# Copy to .env for local development only.
# On Render, add these in Dashboard → Environment (do NOT upload .env files).

PRINTX_ADMIN_EMAIL=pablo.molina@printx.pw
PRINTX_ADMIN_PASSWORD=coolprints.X
PRINTX_SESSION_SECRET=change-me-to-a-long-random-string

# --- Supabase / Postgres (required for persistent data on Render) ---
# PrintX is Vite + Node — not Next.js. Do not use @supabase/ssr or page.tsx.
#
# 1. Create/open your PrintX Supabase project
# 2. Run supabase/schema.sql once in SQL Editor
# 3. Copy DATABASE_URL from: Connect → Session pooler → URI
#    (NOT Direct connection — db.*.supabase.co is IPv6-only and often unreachable)
# Example shape:
# DATABASE_URL=postgresql://postgres.PROJECTREF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
#
# Without DATABASE_URL the server falls back to local SQLite (ephemeral on Render).
DATABASE_URL=

# Optional metadata (server persistence uses DATABASE_URL only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...

# Optional: local upload directory override
# PRINTX_DATA_DIR=/var/data
