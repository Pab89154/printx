# Copy to .env for local development only.
# On Render, add these in Dashboard → Environment (do NOT upload .env files).

PRINTX_ADMIN_EMAIL=pablo.molina@printx.pw
PRINTX_ADMIN_PASSWORD=coolprints.X
PRINTX_SESSION_SECRET=change-me-to-a-long-random-string

# --- Supabase / Postgres (required for persistent data on Render) ---
# PrintX is Vite + Node — not Next.js. Do not use @supabase/ssr or page.tsx.
#
# Setup (one time):
# 1. Create/open your PrintX Supabase project
# 2. SQL Editor → run supabase/schema.sql (creates tables + enables RLS security)
#    "Success, no rows" is normal. Tables remain — that is your data.
# 3. Connect → Session pooler → copy URI as DATABASE_URL below
#    (NOT Direct db.*.supabase.co — IPv6-only and often unreachable on Render)
#
# If Supabase emailed about rls_disabled_in_public and you ran schema.sql before
# RLS was added, run supabase/rls-lockdown.sql once (safe to re-run).
#
# Example DATABASE_URL:
# DATABASE_URL=postgresql://postgres.PROJECTREF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
#
# Without DATABASE_URL the server falls back to local SQLite (ephemeral on Render).
DATABASE_URL=

# Optional — URL needed for Storage; anon key unused by the server today.
# Do not put the service_role / secret key in the frontend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
#
# REQUIRED whenever SUPABASE_URL / DATABASE_URL (Supabase) is set — otherwise
# design uploads stay on ephemeral disk and disappear after Render cold starts.
# Supabase → Project Settings → API → service_role secret
#   (legacy JWT starting with eyJ…, or new sb_secret_… key — NOT the publishable/anon key)
#
# On Render: Web Service "printx" → Environment → Add SUPABASE_SERVICE_ROLE_KEY
#   - Must be available at Runtime (not Build-only)
#   - Exact name: SUPABASE_SERVICE_ROLE_KEY
#   - Then Manual Deploy (Save alone is not enough if the instance is already running)
# Verify: https://printx.pw/api/health → objectStorage.configured true
#          and objectStorage.envPresent.SUPABASE_SERVICE_ROLE_KEY true
SUPABASE_SERVICE_ROLE_KEY=
# Aliases also accepted: SUPABASE_SECRET_KEY, SUPABASE_SERVICE_ROLE

# Optional override (default: printx-models)
# SUPABASE_STORAGE_BUCKET=printx-models

# Optional: local upload directory override
# PRINTX_DATA_DIR=/var/data

# --- Admin portal + cold-start screen ---
# Public site: https://printx.pw
# Admin portal: https://portal.printx.pw
#
# Keep ONE Render Web Service ("printx") with both custom domains.
# To replace Render’s free-tier spinner, put Cloudflare in front (still one web service):
#   → see cloudflare/HOW_TO.md (simple steps)
#
# On Render Environment (also in render.yaml):
# PRINTX_COOKIE_DOMAIN=.printx.pw
#
# Local: http://127.0.0.1:5221 (wake shell in index.html hits /api/health then mounts React)

# --- Admin phone push (Notification Center on iPhone + Pixel) ---
# Generate once: npx web-push generate-vapid-keys
# Put both keys on Render Environment (Runtime), then Manual Deploy.
# Admins: Add portal.printx.pw to Home Screen → Settings → Enable notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@printx.pw

# --- Email notifications (Resend) ---
# Contact / feedback inbox is portal-only (no visitor mail app, no Resend for contact).
# RESEND can still be used for other ops email if configured.
# Setup:
# 1. Create a free account at https://resend.com
# 2. Domains → Add printx.pw → add the DNS records they show
# 3. Create an API key → paste as RESEND_API_KEY on Render (Environment)
# 4. After the domain is verified, From can be hello@printx.pw
#    (until then, PrintX retries with Resend's shared sender automatically)
RESEND_API_KEY=
PRINTX_NOTIFY_EMAIL=hello@printx.pw
PRINTX_MAIL_FROM=PrintX <hello@printx.pw>

# --- Stripe (shop + custom-print checkout) ---
# PrintX policy: Stripe is the ONLY payment processor. Catalog, designs, and
# custom-print prices live in Supabase — never sync Products/Prices into Stripe.
# Checkout uses ad-hoc price_data / PaymentIntents (see docs/PAYMENTS.md).
#
# 1. Create a Stripe account → Developers → API keys → Secret key
# 2. Developers → Webhooks → Add endpoint:
#      URL: https://printx.pw/api/public/stripe-webhook
#      Event: checkout.session.completed
# 3. Paste the signing secret as STRIPE_WEBHOOK_SECRET
# In-person later: Stripe Terminal / Tap to Pay (same account; no Square catalog).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Cloud Slicer (optional override) ---
# Per-admin API tokens live in Settings → Cloud Slicer (DB), not here.
# CLOUD_SLICER_API_BASE=https://api.cloudslicer3d.com
# Optional overrides (defaults use the request host):
# STRIPE_SUCCESS_URL=https://printx.pw/order/success?session_id={CHECKOUT_SESSION_ID}
# STRIPE_CANCEL_URL=https://printx.pw/cart
# PRINTX_PUBLIC_ORIGIN=https://printx.pw
